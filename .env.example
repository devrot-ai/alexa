# FreshKeep environment — copy to .env and adjust. NEVER commit real values.

# --- MCP server (Streamable HTTP) ---
FRESHKEEP_MCP_HOST=0.0.0.0
FRESHKEEP_MCP_PORT=8811

# --- Simulator web app (simulated Alexa+ experience) ---
FRESHKEEP_SIM_HOST=0.0.0.0
FRESHKEEP_SIM_PORT=8800
# FRESHKEEP_MCP_URL=http://127.0.0.1:8811/mcp   # override if MCP runs elsewhere
# FRESHKEEP_SIM_LOCAL=1                           # tests/offline only: skip MCP wire

# --- Storage backend: json (default) | dynamodb ---
FRESHKEEP_STORE=json
FRESHKEEP_JSON_PATH=data/household.json
# FRESHKEEP_STORE=dynamodb
# FRESHKEEP_DYNAMO_TABLE=FreshKeepHousehold
# AWS_REGION=us-east-1                            # resolved from env/IAM as usual

# --- Household (single-household demo build) ---
FRESHKEEP_HOUSEHOLD_ID=demo-household
FRESHKEEP_HOUSEHOLD_NAME=The demo kitchen

# --- Optional Amazon Bedrock natural-language router (AWS Builder) ---
FRESHKEEP_BEDROCK=0
# FRESHKEEP_BEDROCK_MODEL=amazon.nova-lite-v1:0
# FRESHKEEP_BEDROCK_REGION=us-east-1

# --- Optional Amazon Textract receipt-photo extraction ---
FRESHKEEP_TEXTRACT=0
# FRESHKEEP_TEXTRACT_REGION=us-east-1

# --- Safety ---
FRESHKEEP_RATE_LIMIT=30
FRESHKEEP_REQUIRE_CONSENT=1
# FRESHKEEP_AUDIT_PATH=data/audit.log
